# GuruApp Production Environment Template
# Copy to .env.production and fill in your values

# ============================================
# DATABASE (PostgreSQL Local via Docker)
# ============================================
POSTGRES_PASSWORD=changeme_secure_password_here
DATABASE_URL=postgresql://guruapp:${POSTGRES_PASSWORD}@postgres:5432/guruapp

# ============================================
# MINIO (S3-Compatible Storage)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_secure_password_here

# ============================================
# SUPABASE (Use Managed Supabase Cloud - RECOMMENDED)
# ============================================
# Create project at https://supabase.com/dashboard
# Settings → API → copy these values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# AI / OLLAMA
# ============================================
# Ollama doesn't need real API key, but OpenAI client requires one
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://ollama:11434/v1
MODEL_NAME=llama3.1:8b

# Alternative: Use OpenAI directly (comment out Ollama above)
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

# ============================================
# APP
# ============================================
NEXT_PUBLIC_APP_URL=https://your-vps-ip-or-domain
NODE_ENV=production

# Optional: Custom JWT secret
JWT_SECRET=generate-with-openssl-rand-base64-64